App(
    appid="wavehound",
    name="Wavehound",
    apptype=FlipperAppType.EXTERNAL,
    entry_point="wavehound_app",
    requires=["gui", "storage", "notification"],
    stack_size=4 * 1024,
    fap_category="GPIO",
    fap_icon="wavehound.png",
    fap_file_assets="assets",
    fap_version="1.13",
    fap_description="Hunt WiFi access points or any MAC with the WiFi dev board",
    fap_author="Mathias Kiermeier",
    fap_weburl="https://github.com/MatKier/flipperzero-wavehound",
)
